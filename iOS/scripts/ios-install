#!/usr/bin/env bash
# Build (Release by default) and install Sime to a connected iOS device.
# Device identifiers are auto-detected unless overridden via environment:
#   XCODE_DEVICE_ID  — UDID passed to xcodebuild -destination (defaults to the
#                      first connected device, else the only available one)
#   CORE_DEVICE_ID   — identifier passed to `devicectl device install`
#                      (defaults to XCODE_DEVICE_ID)
#   DEVELOPMENT_TEAM — signing team (defaults to the project's team)
#   DERIVED_DATA     — build output location
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
CONFIGURATION="${1:-Release}"
DEVELOPMENT_TEAM="${DEVELOPMENT_TEAM:-8K3SQFBAJG}"
DERIVED_DATA="${DERIVED_DATA:-$ROOT/.local/DerivedData}"

# Auto-detect the connected device UDID when not provided.
if [[ -z "${XCODE_DEVICE_ID:-}" ]]; then
  XCODE_DEVICE_ID="$(xcrun devicectl list devices 2>/dev/null \
    | awk '/connected/ {print $(NF-1); exit}')"
  if [[ -z "$XCODE_DEVICE_ID" ]]; then
    echo "No connected device found. Set XCODE_DEVICE_ID explicitly." >&2
    exit 1
  fi
fi
CORE_DEVICE_ID="${CORE_DEVICE_ID:-$XCODE_DEVICE_ID}"

cd "$ROOT/iOS"
xcodegen generate
cd "$ROOT"

xcodebuild \
  -project iOS/Sime.xcodeproj \
  -scheme Sime \
  -configuration "$CONFIGURATION" \
  -destination "platform=iOS,id=$XCODE_DEVICE_ID" \
  -derivedDataPath "$DERIVED_DATA" \
  DEVELOPMENT_TEAM="$DEVELOPMENT_TEAM" \
  CODE_SIGN_STYLE=Automatic \
  -allowProvisioningUpdates \
  build

APP="$DERIVED_DATA/Build/Products/$CONFIGURATION-iphoneos/Sime.app"
xcrun devicectl device install app --device "$CORE_DEVICE_ID" "$APP"
printf '\nInstalled %s from %s\n' "$CONFIGURATION" "$APP"
